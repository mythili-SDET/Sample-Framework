<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n</Property>
        <Property name="LOG_FILE_PATH">target/logs</Property>
    </Properties>
    
    <Appenders>
        <!-- Console Appender -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <ThresholdFilter level="INFO" onMatch="ACCEPT" onMismatch="DENY"/>
        </Console>
        
        <!-- File Appender for all logs -->
        <RollingFile name="FileAppender" fileName="${LOG_FILE_PATH}/automation.log"
                     filePattern="${LOG_FILE_PATH}/automation-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>
        
        <!-- UI Logger -->
        <RollingFile name="UILogger" fileName="${LOG_FILE_PATH}/ui.log"
                     filePattern="${LOG_FILE_PATH}/ui-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="5MB"/>
            </Policies>
            <DefaultRolloverStrategy max="5"/>
        </RollingFile>
        
        <!-- API Logger -->
        <RollingFile name="APILogger" fileName="${LOG_FILE_PATH}/api.log"
                     filePattern="${LOG_FILE_PATH}/api-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="5MB"/>
            </Policies>
            <DefaultRolloverStrategy max="5"/>
        </RollingFile>
        
        <!-- DB Logger -->
        <RollingFile name="DBLogger" fileName="${LOG_FILE_PATH}/db.log"
                     filePattern="${LOG_FILE_PATH}/db-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="5MB"/>
            </Policies>
            <DefaultRolloverStrategy max="5"/>
        </RollingFile>
        
        <!-- Test Logger -->
        <RollingFile name="TestLogger" fileName="${LOG_FILE_PATH}/test.log"
                     filePattern="${LOG_FILE_PATH}/test-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="5MB"/>
            </Policies>
            <DefaultRolloverStrategy max="5"/>
        </RollingFile>
        
        <!-- Framework Logger -->
        <RollingFile name="FrameworkLogger" fileName="${LOG_FILE_PATH}/framework.log"
                     filePattern="${LOG_FILE_PATH}/framework-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="5MB"/>
            </Policies>
            <DefaultRolloverStrategy max="5"/>
        </RollingFile>
    </Appenders>
    
    <Loggers>
        <!-- UI Logger -->
        <Logger name="UI" level="INFO" additivity="false">
            <AppenderRef ref="UILogger"/>
            <AppenderRef ref="Console"/>
        </Logger>
        
        <!-- API Logger -->
        <Logger name="API" level="INFO" additivity="false">
            <AppenderRef ref="APILogger"/>
            <AppenderRef ref="Console"/>
        </Logger>
        
        <!-- DB Logger -->
        <Logger name="DB" level="INFO" additivity="false">
            <AppenderRef ref="DBLogger"/>
            <AppenderRef ref="Console"/>
        </Logger>
        
        <!-- Test Logger -->
        <Logger name="TEST" level="INFO" additivity="false">
            <AppenderRef ref="TestLogger"/>
            <AppenderRef ref="Console"/>
        </Logger>
        
        <!-- Framework Logger -->
        <Logger name="FRAMEWORK" level="INFO" additivity="false">
            <AppenderRef ref="FrameworkLogger"/>
            <AppenderRef ref="Console"/>
        </Logger>
        
        <!-- Root Logger -->
        <Root level="INFO">
            <AppenderRef ref="FileAppender"/>
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>